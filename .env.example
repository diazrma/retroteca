# --- Login com Google (console.cloud.google.com > APIs e serviços > Credenciais > ID do cliente OAuth)
# URI de redirecionamento autorizado: https://SEU-DOMINIO/api/auth/callback/google
AUTH_SECRET=gere-com-npx-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Banco (Vercel > Storage > Upstash for Redis). A Vercel preenche sozinha:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Notificações push (gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# --- Segurança do cron diário (qualquer texto aleatório)
CRON_SECRET=

# --- URL pública do site (para os links de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://retroteca.vercel.app

# --- Openverse (opcional, grátis): aumenta o limite de buscas de imagens
# Registre em https://api.openverse.org/v1/auth_tokens/register/ e confirme o e-mail
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
